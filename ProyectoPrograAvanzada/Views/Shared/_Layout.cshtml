<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Proyecto Progra Avanzada</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    @* @Styles.Render("~/Content/css") *@

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                @Html.ActionLink("🛒 Tienda Electrónica", "Index", "Producto", new { area = "" }, new { @class = "navbar-brand" })
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">

                        @* --- Enlaces Comunes (Catálogo, Home) --- *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Catálogo", "Index", "Producto", null, new { @class = "nav-link" })
                            </li>
                        }

                        @* ---------------------------------------------
                            ENLACES PARA EL ROL: ADMINISTRADOR
                            --------------------------------------------- *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    ⚙️ Administración
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                    <li>@Html.ActionLink("Gestión de Usuarios", "Index", "User", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Gestión de Roles", "Index", "Rol", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Gestión de Productos", "AdminIndex", "Producto", null, new { @class = "dropdown-item" })</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("✍️ Moderar Reseñas", "Moderation", "Reseña", null, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("Panel", "Dashboard", "Home", null, new { @class = "nav-link text-info" })
                            </li>
                        }

                        @* ---------------------------------------------
                            ENLACES PARA EL ROL: ASOCIADO
                            --------------------------------------------- *@
                        @if (User.IsInRole("Asociado"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("🛍️ Mi Carrito", "Index", "ShoppingCart", null, new { @class = "nav-link" })
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("📚 Historial", "History", "Account", null, new { @class = "nav-link" })
                            </li>
                        }
                    </ul>

                    @* --- Links de Login/Logout y Cuenta --- *@
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white">Bienvenido, **@User.Identity.Name**</span>
                            </li>
                            <li class="nav-item">
                                @* Usamos un formulario para enviar la petición por POST, cumpliendo con la seguridad. *@
                                @using (Html.BeginForm("LogOff", "User", FormMethod.Post, new { @id = "logoffForm", @class = "d-flex" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light ms-2">
                                        Cerrar Sesión
                                    </button>
                                }
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                @Html.ActionLink("🔐 Iniciar Sesión", "Login", "User", null, new { @class = "nav-link" })
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("✍️ Registrarse", "Register", "User", null, new { @class = "nav-link" })

                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container body-content my-4">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted bg-light mt-5">
        <div class="container">
            &copy; @DateTime.Now.Year - Proyecto Programación Avanzada. Todos los derechos reservados.
        </div>
    </footer>

    @* Si usas Bundles, puedes descomentar la siguiente línea *@
    @* @Scripts.Render("~/bundles/jquery") *@

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    @RenderSection("scripts", required: false)
</body>
</html>