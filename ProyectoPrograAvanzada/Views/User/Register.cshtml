@model ProyectoPrograAvanzada.Models.Usuario

@{
    ViewBag.Title = "Registro de Usuario";

}

<h2>@ViewBag.Title</h2>
<h3>Crear una cuenta de Asociado</h3>

@using (Html.BeginForm("Register", "User", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @* Token de seguridad necesario para POST *@
    @Html.AntiForgeryToken()
    <h4>Cree una cuenta nueva.</h4>
    <hr />

    @* Muestra mensajes de error de validación o del servidor *@
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @* Campo Nombre *@
    <div class="form-group">
        @Html.LabelFor(m => m.nombre, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger" })
        </div>
    </div>

    @* Campo Email *@
    <div class="form-group">
        @Html.LabelFor(m => m.email, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.email, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger" })
        </div>
    </div>

    @* Campo Contraseña *@
    <div class="form-group">
        @Html.LabelFor(m => m.contrasena, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @* Usa PasswordFor para ocultar la entrada *@
            @Html.PasswordFor(m => m.contrasena, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.contrasena, "", new { @class = "text-danger" })
        </div>
    </div>

    @* NOTA: Aquí se debe incluir un campo para Confirmar Contraseña (que debe ser parte de un ViewModel) *@

    @* Botón de Enviar *@
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" class="btn btn-primary" value="Registrarse" />
        </div>
    </div>
}

@* Esto es necesario si se validación en el cliente *@
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}