@using ProyectoPrograAvanzada.Models
@model Producto

@{
    ViewBag.Title = "Editar Producto: " + Model.nombreProducto;
}

<h2>@ViewBag.Title</h2>
<hr />

@using (Html.BeginForm("Edit", "Producto", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Modificar Datos del Producto</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @* CAMPO OCULTO: ID del Producto (Obligatorio para la edición) *@
        @Html.HiddenFor(model => model.idProducto)

        <div class="form-group">
            @Html.LabelFor(model => model.nombreProducto, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.nombreProducto, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.nombreProducto, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.descripcion, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.descripcion, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.precioProducto, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.precioProducto, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", min = "0.01" } })
                @Html.ValidationMessageFor(model => model.precioProducto, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.stock, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.stock, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                @Html.ValidationMessageFor(model => model.stock, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.estadoProducto, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.CheckBoxFor(model => model.estadoProducto)
                    @Html.ValidationMessageFor(model => model.estadoProducto, "", new { @class = "text-danger" })
                    <span class="help-block">Marque para que el producto sea visible en el catálogo.</span>
                </div>
            </div>
        </div>

        <hr />

        @* Sección de Gestión de Imágenes (Si ya está implementado el objeto de navegación) *@
        <h4>Gestión de Imágenes</h4>
        <div class="col-md-12">
            <p class="text-info">Aquí se mostrarán las imágenes actuales del producto y la opción para añadir o eliminar.</p>
            @* Ejemplo de visualización de imágenes actuales *@
            @if (Model.Imagenes != null && Model.Imagenes.Any())
            {
                foreach (var imagen in Model.Imagenes)
                {
                    <img src="@imagen.urlImagen" style="width: 100px; height: 100px; object-fit: cover; margin: 5px;" class="img-thumbnail" />
                    @* Aquí se podría incluir un botón para eliminar la imagen (Delete) *@
                }
            }
            else
            {
                <p>No hay imágenes subidas para este producto.</p>
            }

            <label>Subir nuevas imágenes:</label>
            <input type="file" name="fileUpload" multiple class="form-control" />
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10 mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-success" />
                @Html.ActionLink("Cancelar y Volver", "AdminIndex", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}