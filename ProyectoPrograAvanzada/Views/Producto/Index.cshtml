@using ProyectoPrograAvanzada.Models
@model IEnumerable<Producto>

@{
    ViewBag.Title = "Catálogo de Productos";
}

<div class="row">
    <div class="col-md-12">
        <h2>Catálogo de Productos Disponibles</h2>
        <p class="lead">Explora nuestra selección de productos. ¡Recuerda que solo Asociados pueden realizar compras!</p>

        @* Verificar si el usuario es Administrador para darle un enlace al panel de gestión (RF2) *@
        @if (User.IsInRole("Administrador"))
        {
            <div class="alert alert-info">
                @Html.ActionLink("Ir a la Administración de Productos", "AdminIndex", "Producto", null, new { @class = "btn btn-info" })
            </div>
        }

        @* Muestra mensajes de éxito (ej. después de añadir al carrito) *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
    </div>
</div>

<hr />

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-md-12">
            <div class="alert alert-warning">
                No hay productos activos disponibles en este momento.
            </div>
        </div>
    }

    @foreach (var producto in Model)
    {
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100">

                @{
                    // Lógica para mostrar la primera imagen, si existe
                    string imageUrl = producto.Imagenes != null && producto.Imagenes.Any()
                                    ? producto.Imagenes.First().urlImagen
                                    : "/Content/images/placeholder.jpg"; // Usar una imagen de reemplazo
                }
                <a href="@Url.Action("Details", new { id = producto.idProducto })">
                    <img class="card-img-top" src="@imageUrl" alt="@producto.nombreProducto" style="max-height: 200px; width: 100%; object-fit: cover;">
                </a>

                <div class="card-body">
                    <h4 class="card-title">
                        @Html.ActionLink(producto.nombreProducto, "Details", new { id = producto.idProducto })
                    </h4>

                    @* Asume formato de moneda: $1,234.00 *@
                    <h5>@producto.precioProducto.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h5>

                    <p class="card-text">
                        Stock:
                        @if (producto.stock > 0)
                        {
                            <span class="text-success">@producto.stock en inventario</span>
                        }
                        else
                        {
                            <span class="text-danger">Agotado</span>
                        }
                    </p>
                </div>

                <div class="card-footer">
                    @if (producto.stock > 0 && User.IsInRole("Asociado"))
                    {
                        // Formulario POST para agregar un producto al carrito (RF3)
                        using (Html.BeginForm("AddItem", "ShoppingCart", FormMethod.Post, new { @class = "form-inline" }))
                        {
                            @Html.Hidden("idProducto", producto.idProducto)
                            <input type="number" name="cantidad" value="1" min="1" max="@producto.stock" class="form-control input-sm" style="width: 60px; margin-right: 5px;" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="glyphicon glyphicon-shopping-cart"></i> Añadir
                            </button>
                        }
                    }
                    else if (producto.stock > 0)
                    {
                        // Si no es asociado (ej. no logueado)
                        <span class="text-muted">Inicie sesión para comprar</span>
                    }
                </div>
            </div>
        </div>
    }
</div>