@using ProyectoPrograAvanzada.Models
@model IEnumerable<Orden>

@{
    ViewBag.Title = "Historial de Compras";
}

<h2>@ViewBag.Title</h2>
<p class="lead">Consulta todas las órdenes que has realizado.</p>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="glyphicon glyphicon-info-sign"></i> Aún no has realizado ninguna compra.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID Orden</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Detalles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var orden in Model.OrderByDescending(o => o.fecha))
            {
                <tr>
                    <td>#@orden.idOrden</td>
                    <td>@orden.fecha.ToShortDateString()</td>
                    <td><strong class="text-success">@orden.total.ToString("C", new System.Globalization.CultureInfo("es-CR"))</strong></td>
                    <td>
                        <button type="button" class="btn btn-xs btn-info" data-toggle="collapse" data-target="#details-@orden.idOrden" aria-expanded="false" aria-controls="details-@orden.idOrden">
                            Ver Productos (@orden.DetallesOrden.Count() productos)
                        </button>
                    </td>
                </tr>

                @* Fila de Detalles Oculta (Colapsable) *@
                <tr class="collapse" id="details-@orden.idOrden">
                    <td colspan="4">
                        <table class="table table-condensed" style="background-color: #f9f9f9;">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio de Compra</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in orden.DetallesOrden)
                                {
                                    <tr>
                                        <td>@(detalle.Producto?.nombreProducto ?? "Producto Eliminado")</td>
                                        <td>@detalle.cantidad</td>
                                        <td>@detalle.precioUnitario.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                        <td>@detalle.calcularSubtotal.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">Si requiere más información sobre una orden, por favor, contacte a soporte técnico.</p>
}