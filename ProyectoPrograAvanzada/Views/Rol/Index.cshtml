@model IEnumerable<ProyectoPrograAvanzada.Models.Rol>

@{
    ViewBag.Title = "Gestión de Roles";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Asume que tienes un layout base
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <h2 class="display-6">⚙️ Gestión de Roles</h2>
        </div>
        <div class="col-md-6 text-end">
            @Html.ActionLink("➕ Crear Nuevo Rol", "Create", null, new { @class = "btn btn-primary" })
        </div>
    </div>

    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th style="width: 10%;">@Html.DisplayNameFor(model => model.idRol)</th>
                <th>@Html.DisplayNameFor(model => model.nombreRol)</th>
                <th style="width: 25%;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.idRol)</td>
                        <td>@Html.DisplayFor(modelItem => item.nombreRol)</td>
                        <td>
                            @Html.ActionLink("✏️ Editar", "Edit", new { id = item.idRol }, new { @class = "btn btn-sm btn-info me-2" })

                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@item.idRol">
                                🗑️ Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No hay roles definidos en el sistema.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@foreach (var item in Model ?? Enumerable.Empty<ProyectoPrograAvanzada.Models.Rol>())
{
    <div class="modal fade" id="deleteModal_@item.idRol" tabindex="-1" aria-labelledby="deleteModalLabel_@item.idRol" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel_@item.idRol">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Está seguro de que desea eliminar el rol **@item.nombreRol**?
                    <p class="text-danger small mt-2">Advertencia: Esto fallará si el rol tiene usuarios asignados.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    @using (Html.BeginForm("Delete", "Rol", new { id = item.idRol }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}