@using MvcTienda.Aplicacion.Resenas
@model IEnumerable<ResenaDto>

@{
    ViewBag.Title = "Moderación de Reseñas";
}

<h2>@ViewBag.Title</h2>
<p class="lead">Listado de reseñas enviadas por los asociados que requieren aprobación.</p>

@* Mostrar mensajes de éxito o error después de una acción de moderación *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="glyphicon glyphicon-ok-circle"></i> ¡No hay reseñas pendientes de moderación en este momento!
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>Producto</th>
                <th>Usuario</th>
                <th>@Html.DisplayNameFor(model => model.Comentario)</th>
                <th>@Html.DisplayNameFor(model => model.Calificacion)</th>
                <th>@Html.DisplayNameFor(model => model.Fecha)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resena in Model)
            {
                <tr>
                    <td>@resena.Id</td>
                    <td>
                        @* El DTO ahora debe tener la propiedad NombreProducto *@
                        @Html.ActionLink(resena.NombreProducto ?? "Producto Eliminado", "Details", "Producto", new { id = resena.IdProducto }, new { target = "_blank" })
                    </td>
                    @* El DTO ahora debe tener la propiedad NombreUsuario *@
                    <td>@(resena.NombreUsuario ?? "Usuario Desconocido")</td>
                    <td>
                        <p style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@resena.Comentario">
                            @resena.Comentario
                        </p>
                    </td>
                    <td>
                        <span class="label label-primary">@resena.Calificacion / 5</span>
                    </td>
                    <td>@resena.Fecha.ToShortDateString()</td>
                    <td>
                        @* -- Formulario para APROBAR -- *@
                        @using (Html.BeginForm("Approve", "Resena", new { id = resena.Id }, FormMethod.Post, new { style = "display:inline; margin-right: 5px;" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-xs btn-success" title="Aprobar Reseña">
                                Aprobar
                            </button>
                        }

                        @* -- Formulario para RECHAZAR/ELIMINAR -- *@
                        @using (Html.BeginForm("Reject", "Resena", new { id = resena.Id }, FormMethod.Post, new { style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('¿Está seguro de que desea rechazar y ELIMINAR permanentemente esta reseña?');" title="Rechazar Reseña">
                                Rechazar
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}