@{
    ViewBag.Title = "Panel de Administración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">
        <i class="bi bi-speedometer2 text-info me-2"></i>Panel de Administración
    </h2>
    <p class="text-muted mb-0">
        Resumen general del sistema, actividad reciente y métricas clave.
    </p>
</div>

<!-- ================= KPIs PRINCIPALES ================= -->
<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-people-fill text-info fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Usuarios Totales</h6>
                <h2 class="fw-bold mb-0" id="totalUsuarios">-</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-person-check-fill text-success fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Usuarios Activos</h6>
                <h2 class="fw-bold mb-0" id="usuariosActivos">-</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-person-x-fill text-danger fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Usuarios Inactivos</h6>
                <h2 class="fw-bold mb-0" id="usuariosInactivos">-</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-box-seam text-dark fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Productos</h6>
                <h2 class="fw-bold mb-0" id="totalProductos">-</h2>
            </div>
        </div>
    </div>

</div>

<!-- ================= INVENTARIO Y VENTAS ================= -->
<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Inventario Crítico</h6>
                <h2 class="fw-bold mb-0" id="productosBajoInventario">-</h2>
                <small class="text-muted">Productos con stock bajo</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-currency-exchange text-success fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Ventas (7 días)</h6>
                <h2 class="fw-bold mb-0" id="ventasUltimaSemana">₡ -</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-graph-up-arrow text-info fs-2 mb-2"></i>
                <h6 class="text-muted text-uppercase small mb-1">Promedio Diario</h6>
                <h2 class="fw-bold mb-0" id="promedioVentas">₡ -</h2>
            </div>
        </div>
    </div>

</div>

<!-- ================= GRÁFICOS ================= -->
<div class="row g-4">

    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-bar-chart-line-fill text-info me-2"></i>Ventas de la Última Semana
                </h5>
                <canvas id="ventasChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-pie-chart-fill text-info me-2"></i>Estado de Usuarios
                </h5>
                <canvas id="usuariosChart"></canvas>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/dashboard.js"></script>
}
