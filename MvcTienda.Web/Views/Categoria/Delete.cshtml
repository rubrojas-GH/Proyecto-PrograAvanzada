@model MvcTienda.Aplicacion.Categorias.CategoriaDto

@{
    ViewBag.Title = "Eliminar Categoría";
}

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-danger" style="margin-top: 30px;">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="glyphicon glyphicon-trash"></i> Confirmar Eliminación</h3>
            </div>
            <div class="panel-body text-center">
                <h4>¿Está seguro de que desea eliminar esta categoría?</h4>
                <hr />
                <div class="well">
                    <h2 class="text-danger">@Model.NombreCategoria</h2>
                    <p class="text-muted">ID: @Model.IdCategoria</p>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.IdCategoria)

                    <div class="alert alert-warning">
                        <i class="glyphicon glyphicon-warning-sign"></i>
                        <strong>Atención:</strong> Si esta categoría tiene productos asociados, la operación podría fallar o dejar productos sin categoría.
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="glyphicon glyphicon-ok"></i> Confirmar y Eliminar
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-lg" })
                }
            </div>
        </div>
    </div>
</div>