<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@using MvcTienda.Aplicacion.Categorias
@model IEnumerable<CategoriaDto>

@{
    ViewBag.Title = "Gestión de Categorías";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <h2 class="text-dark fw-bold">@ViewBag.Title</h2>
        <p class="text-muted">Administra las clasificaciones para organizar los productos del catálogo.</p>
    </div>
    <div>
        @* Cambia "Create" por el nombre de tu método para crear categorías si es distinto *@
        <a href="@Url.Action("Create", "Categoria")" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nueva Categoría
        </a>
        <a href="@Url.Action("AdminIndex", "Producto")" class="btn btn-outline-secondary shadow-sm">
            Volver a Productos
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary text-uppercase small fw-bold">
                <tr>
                    <th class="ps-3" style="width: 100px;">ID</th>
                    <th>Nombre de Categoría</th>
                    <th>Descripción</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">#@item.IdCategoria</td>
                            <td>
                                <div class="fw-bold text-dark">@item.NombreCategoria</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.DescripcionCategoria))
                                {
                                    <span class="text-muted small">@item.DescripcionCategoria</span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Sin descripción</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="@Url.Action("Edit", "Categoria", new { id = item.IdCategoria })"
                                       class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    @using (Html.BeginForm("Delete", "Categoria", new { id = item.IdCategoria }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Está seguro de eliminar esta categoría? Esto podría afectar a los productos asociados.');" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            No hay categorías registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}