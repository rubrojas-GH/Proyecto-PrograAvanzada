@model MvcTienda.Aplicacion.Categorias.CategoriaDto

@{
    ViewBag.Title = "Nueva Categoría";
}

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-primary" style="margin-top: 30px;">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="glyphicon glyphicon-plus"></i> Registrar Nueva Categoría</h3>
            </div>
            <div class="panel-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.NombreCategoria, "Nombre de la Categoría", htmlAttributes: new { @class = "control-label col-md-12", style = "text-align: left;" })
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.NombreCategoria, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Electrónica" } })
                                @Html.ValidationMessageFor(model => model.NombreCategoria, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <hr />

                        <div class="form-group">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="glyphicon glyphicon-save"></i> Guardar Categoría
                                </button>
                                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Solo mostramos el ID si es mayor a 0 (es decir, si ya existe) *@
        @if (Model != null && Model.IdCategoria > 0)
        {
            <p class="text-muted">
                <small>ID de Registro: @Model.IdCategoria</small>
            </p>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}