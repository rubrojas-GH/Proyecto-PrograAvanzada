@using MvcTienda.Aplicacion.Productos
@model IEnumerable<ProductoDto>

@{
    ViewBag.Title = "Administración de Productos";
}

<h2>@ViewBag.Title</h2>
<p class="lead">Gestión de la información y el inventario del catálogo.</p>

<p>
    @Html.ActionLink("Crear Nuevo Producto", "Create", null, new { @class = "btn btn-primary" })
</p>

@* Mostrar mensajes de éxito o error después de un CRUD *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th> // 👈 AJUSTE: Id
            <th>@Html.DisplayNameFor(model => model.Nombre)</th> // 👈 AJUSTE: Nombre
            <th>@Html.DisplayNameFor(model => model.Precio)</th> // 👈 AJUSTE: PrecioProducto
            <th>@Html.DisplayNameFor(model => model.Stock)</th> // 👈 AJUSTE: Stock
            <th>@Html.DisplayNameFor(model => model.EstadoProducto)</th> // 👈 AJUSTE: EstadoProducto
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // Resaltar productos inactivos o con bajo stock para el administrador
            string rowClass = "";
            if (item.EstadoProducto == false)
            {
                rowClass = "danger"; // Inactivo: Rojo
            }
            else if (item.Stock <= 5)
            {
                rowClass = "warning"; // Stock bajo: Amarillo
            }

            <tr class="@rowClass">
                <td>@Html.DisplayFor(modelItem => item.Id)</td> // 👈 AJUSTE: Id
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td> // 👈 AJUSTE: Nombre
                <td>@item.PrecioProducto.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                <td>@Html.DisplayFor(modelItem => item.Stock)</td> // 👈 AJUSTE: Stock
                <td>
                    @if (item.EstadoProducto == true) // 👈 AJUSTE: EstadoProducto
                    {
                        <span class="label label-success">Activo</span>
                    }
                    else
                    {
                        <span class="label label-default">Inactivo</span>
                    }
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-xs btn-default" }) | // 👈 AJUSTE: Id
                    @Html.ActionLink("Detalles", "Details", new { id = item.Id }, new { @class = "btn btn-xs btn-default" }) | // 👈 AJUSTE: Id
                    @* Usamos un formulario para la acción de Eliminar por seguridad *@
                    @using (Html.BeginForm("Delete", "Producto", new { id = item.Id }, FormMethod.Post, new { style = "display:inline;" })) // 👈 AJUSTE: Id
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('¿Está seguro de que desea eliminar este producto? (Esta acción es permanente)');">
                            Eliminar
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>