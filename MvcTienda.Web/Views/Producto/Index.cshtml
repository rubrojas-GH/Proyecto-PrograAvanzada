@using MvcTienda.Aplicacion.Productos
@model IEnumerable<ProductoDto>

@{
    ViewBag.Title = "Nuestra Tienda";
    var categorias = (IEnumerable<MvcTienda.Aplicacion.Categorias.CategoriaDto>)ViewBag.Categorias;
    var categoriaActualId = (int?)ViewBag.CategoriaActualId;
}

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="cartToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-info-circle me-2" id="toastIcon"></i>
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="container mt-4">
    @* Encabezado Dinámico *@
    <div class="text-center mb-5">
        <h2 class="display-6 fw-bold">Catálogo de Productos</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">
            Explora nuestra colección seleccionada. Inicia sesión para disfrutar de una compra segura como Asociado.
        </p>
    </div>

    <div class="row">
        @* Filtros Laterales *@
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 85px; z-index: 1000;">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3"><i class="bi bi-filter-left me-2"></i>Categorías</h5>
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("Index", "Producto")"
                           class="list-group-item list-group-item-action border-0 rounded @(categoriaActualId == null ? "active bg-primary text-white" : "")">
                            Todas las Categorías
                        </a>

                        @foreach (var cat in categorias)
                        {
                            bool isActive = categoriaActualId == cat.IdCategoria;
                            <a href="@Url.Action("Index", "Producto", new { categoriaId = cat.IdCategoria })"
                               class="list-group-item list-group-item-action border-0 rounded @(isActive ? "active bg-primary text-white" : "")">
                                @cat.NombreCategoria
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Listado de Productos *@
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-light rounded-3 shadow-sm">
                    <i class="bi bi-search display-1 text-muted"></i>
                    <p class="mt-3 lead">No encontramos productos en esta categoría.</p>
                </div>
            }

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var producto in Model)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm transition-hover overflow-hidden">
                            @* Imagen con enlace a detalles *@
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <a href="@Url.Action("Details", new { id = producto.Id })">
                                    <img src="@(producto.Imagenes?.FirstOrDefault()?.UrlImagen ?? "https://placehold.co/600x400")"
                                         class="card-img-top h-100 w-100" style="object-fit: cover;" alt="@producto.Nombre">
                                </a>
                                @if (producto.Stock <= 0)
                                {
                                    <div class="position-absolute top-0 end-0 bg-danger text-white px-3 py-1 m-2 rounded-pill small fw-bold">Agotado</div>
                                }
                            </div>

                            <div class="card-body">
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">@producto.NombreCategoria</small>
                                <h5 class="card-title mt-1 mb-2">@producto.Nombre</h5>
                                <p class="text-primary fs-5 fw-bold mb-0">@producto.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</p>

                                @* --- AJUSTE VISUAL DE STOCK --- *@
                                <div class="mt-2">
                                    <small class="text-muted d-block">
                                        Stock Total: <span id="stock-total-@producto.Id">@producto.Stock</span>
                                    </small>
                                    @* JS llenará este span con "Ya tienes X en el carrito" *@
                                    <small class="text-info d-block fw-bold" id="stock-info-@producto.Id"></small>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-0 pt-0 pb-3">
                                @if (producto.Stock > 0 && User.IsInRole("Asociado"))
                                {
                                    using (Html.BeginForm("AddItem", "ShoppingCart", FormMethod.Post, new { @class = "ajax-cart-form" }))
                                    {
                                        @Html.Hidden("idProducto", producto.Id)

                                        <div class="input-group input-group-sm">
                                            <input type="number"
                                                   name="cantidad"
                                                   value="1"
                                                   min="1"
                                                   max="@producto.Stock"
                                                   class="form-control txt-cantidad-item" />

                                            <button type="submit" class="btn btn-primary px-3 btn-add-cart">
                                                <i class="bi bi-cart-plus"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else if (producto.Stock > 0)
                                {
                                    <a href="@Url.Action("Details", new { id = producto.Id })" class="btn btn-sm btn-outline-secondary w-100 rounded-pill">
                                        Ver Detalles
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/carrito-ajax.js"></script>

    <style>
        .animate-pulse {
            transform: scale(1.4);
            transition: transform 0.2s ease;
        }

        .transition-hover {
            transition: transform 0.3s ease;
        }

            .transition-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }

        /* Estilo para el mensaje de "Ya tienes X" */
        .text-info {
            font-size: 0.85rem;
        }
    </style>
}