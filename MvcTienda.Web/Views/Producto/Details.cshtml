@using MvcTienda.Aplicacion.Productos
@using MvcTienda.Aplicacion.Resenas
@model ProductoDto

@{
    ViewBag.Title = Model.Nombre;
}

<div class="row">
    <div class="col-md-12">
        @* Mensajes de confirmación (ej. resena enviada, producto añadido) *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
    </div>
</div>

<div class="row">

    @* ============================================== *@
    @* COLUMNA DE IMÁGENES              *@
    @* ============================================== *@
    <div class="col-md-6">
        <h2 class="mb-4">@Model.Nombre</h2> 

        @if (Model.Imagenes != null && Model.Imagenes.Any())
        {
            // Usamos el ImagenProductoDto anidado
            string mainImageUrl = Model.Imagenes.First().UrlImagen;
            <img src="@mainImageUrl" alt="@Model.Nombre" class="img-responsive img-thumbnail" style="max-height: 400px; width: auto; margin-bottom: 20px;" />

            // Aquí se podrían listar más imágenes o un carrusel
        }
        else
        {
            <img src="/Content/images/placeholder.jpg" alt="No Image" class="img-responsive img-thumbnail" style="max-height: 400px; width: auto; margin-bottom: 20px;" />
        }
    </div>

    @* ============================================== *@
    @* COLUMNA DE INFORMACIÓN Y COMPRA     *@
    @* ============================================== *@
    <div class="col-md-6">

        <h3 class="text-primary">@Model.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h3>
        <hr />

        <dl class="dl-horizontal">
            <dt>Descripción</dt>
            <dd>@(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>

            <dt>Disponibilidad</dt>
            <dd>
                @if (Model.EstadoProducto == true)
                {
                    <span class="label label-success">Activo</span>
                }
                else
                {
                    <span class="label label-default">Inactivo</span>
                }
            </dd>

            <dt>Stock Actual</dt>
            <dd>
                @if (Model.Stock > 0)
                {
                    <strong class="text-success">@Model.Stock unidades</strong>
                }
                else
                {
                    <strong class="text-danger">Agotado</strong>
                }
            </dd>
        </dl>

        <hr />

        @* Lógica para Añadir al Carrito (RF3) *@
        @if (Model.Stock > 0 && User.IsInRole("Asociado"))
        {
            <h4>Añadir al Carrito</h4>
            using (Html.BeginForm("AddItem", "ShoppingCart", FormMethod.Post, new { @class = "form-inline" }))
            {
                @Html.Hidden("idProducto", Model.Id)

                <div class="form-group">
                    <label for="cantidad">Cantidad:</label>
                    <input type="number" name="cantidad" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 80px; margin-right: 10px;" required />
                </div>

                <button type="submit" class="btn btn-lg btn-success">
                    <i class="glyphicon glyphicon-shopping-cart"></i> Comprar
                </button>
            }
        }
        else if (Model.Stock > 0)
        {
            <p class="text-info">Inicie sesión como Asociado para comprar este producto.</p>
        }
        else
        {
            <p class="text-danger">Este producto se encuentra agotado temporalmente.</p>
        }

    </div>
</div>

<hr />

@* ============================================== *@
@* SECCIÓN DE RESEÑAS (RF4) - AJUSTADA         *@
@* ============================================== *@
<div class="row">
    <div class="col-md-12">
        <h3>
            Reseñas de Usuarios
            @if (User.IsInRole("Asociado"))
            {
                // Enlace para crear una resena (solo Asociados)
                @Html.ActionLink("Escribir una Reseña", "Create", "Resena", new { id = Model.Id }, new { @class = "btn btn-xs btn-primary pull-right" })
            }
        </h3>

        <hr />

        @{
            // El servicio de reseñas ya se encargó de filtrar por 'Aprobada'
            // Usamos la colección de DTOs de reseñas
            var resenasAprobadas = Model.Resenas?.ToList() ?? new List<ResenaDto>();
        }

        @if (!resenasAprobadas.Any())
        {
            <div class="alert alert-info">
                Aún no hay reseñas aprobadas para este producto. ¡Sé el primero en dejar una!
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var resena in resenasAprobadas.OrderByDescending(r => r.Fecha))
                {
                    <li class="list-group-item">
                        <div class="row">
                            <div class="col-xs-12">
                                @* 2. AJUSTE CRÍTICO: Usar NombreUsuario y Fecha del DTO * @
                                    <strong>@resena.NombreUsuario</strong>
                                    <small class="pull-right text-muted">@resena.Fecha.ToShortDateString()</small>
                                    <p>@resena.Comentario</p> @* 👈 AJUSTE: Usar Comentario *@

                                @* Opcional: Mostrar estrellas de calificación (Calificacion) *@
                                @for (int i = 0; i < resena.Calificacion; i++)
                                {
                                    <span class="glyphicon glyphicon-star" style="color: gold;"></span>
                                }
                                @for (int i = resena.Calificacion; i < 5; i++)
                                {
                                    <span class="glyphicon glyphicon-star-empty" style="color: lightgray;"></span>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }

    </div>
</div>

<hr />

@* Enlace para volver al catálogo *@
<p>
    @Html.ActionLink("← Volver al Catálogo", "Index", "Producto")
</p>