@using MvcTienda.Aplicacion.Productos
@using MvcTienda.Aplicacion.Resenas
@model ProductoDto

@{
    ViewBag.Title = Model.Nombre;
}

<div class="container mt-4">
    @* Mensajes de Feedback (Éxito al enviar reseña o agregar al carrito) *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-5">
        @* --- COLUMNA DE IMÁGENES --- *@
        <div class="col-md-6">
            @{
                var imagenPrincipal = Model.Imagenes?.FirstOrDefault()?.UrlImagen
                                     ?? "https://placehold.co/600x600?text=" + Server.UrlEncode(Model.Nombre);
            }

            <div class="main-image-container bg-white p-3 rounded shadow-sm border mb-3">
                <img src="@imagenPrincipal" alt="@Model.Nombre" class="img-fluid" style="width: 100%; max-height: 500px; object-fit: contain;" />
            </div>

            @if (Model.Imagenes != null && Model.Imagenes.Count() > 0)
            {
                <div class="row g-2">
                    @foreach (var img in Model.Imagenes)
                    {
                        <div class="col-3">
                            @* Añadimos un pequeño script para que al hacer clic cambie la foto grande *@
                            <img src="@img.UrlImagen"
                                 class="img-thumbnail shadow-sm"
                                 style="cursor: pointer; height: 80px; width: 100%; object-fit: cover;"
                                 onclick="document.querySelector('.main-image-container img').src = this.src" />
                        </div>
                    }
                </div>
            }
        </div>

        @* --- COLUMNA DE INFORMACIÓN --- *@
        <div class="col-md-6">
            <h1 class="fw-bold text-dark mb-3">@Model.Nombre</h1>
            <h2 class="text-primary fw-bold mb-4">@Model.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</h2>

            <div class="bg-light p-4 rounded-3 border mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8 text-primary fw-bold">@Model.NombreCategoria</dd>

                    @* AJUSTE DE STOCK DINÁMICO *@
                    <dt class="col-sm-4 mt-2">Stock Total</dt>
                    <dd class="col-sm-8 mt-2">
                        <span id="stock-total-@Model.Id" class="@(Model.Stock <= 5 ? "text-danger fw-bold" : "")">@Model.Stock</span> unidades
                    </dd>

                    @* GANCHO PARA JS: Aquí se mostrará "Ya tienes X en el carrito" *@
                    <dt class="col-sm-4 mt-2"></dt>
                    <dd class="col-sm-8 mt-1">
                        <span id="stock-info-@Model.Id" class="text-info fw-bold small"></span>
                    </dd>
                </dl>
            </div>

            <p class="text-muted mb-4 lead">@Model.Descripcion</p>

            @* Lógica de Compra *@
            <div class="d-grid gap-2">
                @if (Model.Stock > 0 && User.IsInRole("Asociado"))
                {
                    using (Html.BeginForm("AddItem", "ShoppingCart", FormMethod.Post, new { @class = "ajax-cart-form p-3 border rounded bg-white shadow-sm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("idProducto", Model.Id)
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <label class="small fw-bold">CANTIDAD:</label>
                                <input type="number" name="cantidad" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 80px;" required />
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-success btn-lg w-100 mt-3 mt-sm-0">
                                    <i class="bi bi-cart-plus-fill me-2"></i> Añadir al Carrito
                                </button>
                            </div>
                        </div>
                    }
                }
                else if (Model.Stock > 0 && !User.Identity.IsAuthenticated)
                {
                    @* Solo mostramos advertencia si no está logueado *@
                    <div class="alert alert-warning border-0 shadow-sm">
                        <i class="bi bi-info-circle-fill me-2"></i> Inicie sesión como <strong>Asociado</strong> para realizar compras.
                    </div>
                }
                else if (Model.Stock <= 0)
                {
                    <button class="btn btn-secondary btn-lg" disabled>Agotado Temporalmente</button>
                }
            </div>
        </div>
    </div>

    <hr class="my-5" />

    @* --- SECCIÓN DE RESEÑAS --- *@
    <div class="row pb-5">
        <div class="col-md-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold"><i class="bi bi-chat-quote-fill text-primary me-2"></i>Reseñas de la Comunidad</h3>

                @* Permitir botón si es Asociado *@
                @if (User.IsInRole("Asociado"))
                {
                    <a href="@Url.Action("Create", "Resena", new { id = Model.Id })" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Escribir Reseña
                    </a>
                }
            </div>

            @* Filtrar solo reseñas con Estado "Aprobada" *@
            @{
                var resenasAprobadas = Model.Resenas?
                                        .Where(r => r.Estado == "Aprobada")
                                        .OrderByDescending(r => r.Fecha)
                                        .ToList() ?? new List<ResenaDto>();
            }

            @if (!resenasAprobadas.Any())
            {
                <div class="text-center py-5 bg-light rounded shadow-sm border border-dashed">
                    <p class="text-muted mb-0">Aún no hay opiniones aprobadas para este producto. ¡Sé el primero!</p>
                </div>
            }
            else
            {
                foreach (var resena in resenasAprobadas)
                {
                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold"><i class="bi bi-person-circle me-2"></i>@resena.NombreUsuario</span>
                                <small class="text-muted">@resena.Fecha.ToShortDateString()</small>
                            </div>

                            <div class="mb-2 text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= resena.Calificacion ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>

                            <p class="card-text text-dark">@resena.Comentario</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="mb-5">
        <a href="@Url.Action("Index", "Producto")" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
        </a>
    </div>
</div>

@section Scripts {
    @* 1. SweetAlert2 para mensajes modernos *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* 2. El script centralizado que creamos *@
    <script src="~/Scripts/carrito-ajax.js"></script>

    <script>
        // Pequeño ajuste visual para la galería de imágenes
        function cambiarImagen(url) {
            document.querySelector('.main-image-container img').src = url;
        }
    </script>

    <style>
        /* Estilos para el efecto de pulso en el navbar al añadir */
        #cart-count.animate-pulse {
            transform: scale(1.4);
            transition: transform 0.2s ease;
            color: #ffc107; /* Opcional: cambia a color dorado un instante */
        }
    </style>
}