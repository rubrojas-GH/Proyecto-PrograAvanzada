@using MvcTienda.Web.Models
@model LoginViewModel
@{
    ViewBag.Title = "Bienvenido de nuevo";
}

<div class="row justify-content-center align-items-center m-0" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 rounded-circle mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-shield-lock text-info fs-1"></i>
                    </div>
                    <h2 class="fw-bold text-dark">@ViewBag.Title</h2>
                    <p class="text-muted small">Ingresa tus credenciales para continuar</p>
                </div>

                @using (Html.BeginForm("Login", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form", @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 small py-2" })

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light border-0 p-2", placeholder = "correo@ejemplo.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger x-small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-key text-muted"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-light border-0 p-2", placeholder = "••••••••" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger x-small" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            <label class="form-check-label small text-muted" for="RememberMe">Recordarme</label>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg py-2 fs-6 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </button>
                    </div>
                }

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">¿Aún no tienes cuenta?</p>
                    @Html.ActionLink("Crear una cuenta nueva", "Register", "User", null, new { @class = "text-info fw-bold text-decoration-none small" })
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Home")" class="text-muted small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Volver a la tienda
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}