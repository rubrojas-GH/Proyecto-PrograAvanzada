@model MvcTienda.Aplicacion.Usuarios.UsuarioCreateDto
@{
    ViewBag.Title = "Registro de Asociado";
}

<div class="row justify-content-center align-items-center m-0" style="min-height: 85vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark mb-1">Crea tu cuenta</h2>
                    <p class="text-muted small">Únete a nuestra comunidad de asociados</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 small py-2 shadow-sm">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                @using (Html.BeginForm("Register", "User", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nombre Completo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control border-start-0 ps-0", placeholder = "Ej: Juan Pérez" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger x-small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", placeholder = "tu@correo.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger x-small" })
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Contraseña</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control shadow-sm p-2", placeholder = "Mín. 6 caracteres" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger x-small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Confirmar</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control shadow-sm p-2", placeholder = "Repite la contraseña" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger x-small" })
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-info text-white btn-lg py-2 fs-6 shadow-sm fw-bold">
                            Registrarme ahora
                        </button>
                    </div>
                }

                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">¿Ya tienes una cuenta?</p>
                    @Html.ActionLink("Inicia sesión aquí", "Login", "User", null, new { @class = "text-dark fw-bold text-decoration-none" })
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .x-small {
        font-size: 0.7rem;
    }

    .form-control:focus {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.15);
    }

    .input-group-text {
        border-color: #dee2e6;
    }
</style>