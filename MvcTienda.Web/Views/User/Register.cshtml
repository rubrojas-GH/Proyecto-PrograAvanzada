@model MvcTienda.Aplicacion.Usuarios.UsuarioCreateDto
@{
    ViewBag.Title = "Registro de Asociado";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>

    @* Apunta al Controller "User" *@
    @using (Html.BeginForm("Register", "User", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        <h4>Cree una cuenta nueva de Asociado.</h4>
        <hr />

        @* Muestra el resumen de errores (ej. "El correo ya está registrado.") *@
        @Html.ValidationSummary("", new { @class = "text-danger" })

        @* 1. CAMPO NOMBRE (Nombre Completo) *@
        <div class="row mb-3">
            @Html.LabelFor(m => m.Nombre, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Juan Pérez" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>
        </div>

        @* 2. CAMPO EMAIL *@
        <div class="row mb-3">
            @Html.LabelFor(m => m.Email, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>
        </div>

        @* 3. CAMPO PASSWORD *@
        <div class="row mb-3">
            @Html.LabelFor(m => m.Password, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        @* 4. CAMPO CONFIRMACIÓN DE PASSWORD *@
        <div class="row mb-3">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
        </div>

        @* === BOTÓN DE ENVÍO === *@

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <input type="submit" value="Registrarse" class="btn btn-outline-dark" />
            </div>
        </div>
    }

    @* Si se desea añadir un enlace de vuelta al Login: *@
    <p class="mt-3">
        @Html.ActionLink("¿Ya tiene una cuenta? Inicie sesión aquí.", "Login", "User")
    </p>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}