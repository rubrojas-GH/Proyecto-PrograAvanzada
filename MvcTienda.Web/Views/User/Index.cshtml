<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

@using MvcTienda.Aplicacion.Usuarios
@model IEnumerable<UsuarioDto>

@{
    ViewBag.Title = "Administración de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <div>
        <h2 class="text-dark fw-bold">@ViewBag.Title</h2>
        <p class="text-muted">Gestión de usuarios, asignación de roles y control de estados del sistema.</p>
    </div>
    <div>
        @* Descomenta si tienes vista de creación de usuarios *@
        @* <a href="@Url.Action("Create", "Usuario")" class="btn btn-primary shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
            </a> *@
    </div>
</div>

@* Mensajes de Feedback *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary text-uppercase small fw-bold">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Última Conexión</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string statusClass = (item.Estado == true) ? "text-success" : "text-danger";
                    string roleBadge = (item.Rol == "Administrador") ? "bg-primary" : "bg-info text-dark";

                    <tr>
                        <td class="ps-3 fw-bold text-muted">#@item.Id</td>
                        <td>
                            <div class="fw-bold text-dark">@item.Nombre</div>
                        </td>
                        <td class="text-muted">@item.Email</td>
                        <td>
                            <span class="badge @roleBadge opacity-75">
                                @(item.Rol ?? "Sin Rol")
                            </span>
                        </td>
                        <td>
                            <i class="bi bi-circle-fill @statusClass small me-1"></i>
                            <span class="small">@(item.Estado == true ? "Activo" : "Inactivo")</span>
                        </td>
                        <td class="small text-muted">
                            @item.UltimaConexion.ToString("dd MMM yyyy, HH:mm")
                        </td>
                        <td class="text-end pe-3">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="@Url.Action("Edit", "Usuario", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-primary" title="Editar Usuario">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                @* Botón para cambiar estado o eliminar (opcional) *@
                                @using (Html.BeginForm("Delete", "Usuario", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Está seguro de cambiar el estado de este usuario?');" title="Desactivar">
                                        <i class="bi bi-person-x-fill"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>