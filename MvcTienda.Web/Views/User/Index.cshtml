@using MvcTienda.Aplicacion.Usuarios
@model IEnumerable<UsuarioDto>

@{
    ViewBag.Title = "Administración de Usuarios";
}

<h2>@ViewBag.Title</h2>
<p class="lead">Gestión de usuarios y asignación de roles y estados del sistema.</p>

@* Mensajes *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th> @* Usamos Id del DTO *@
            <th>@Html.DisplayNameFor(model => model.Nombre)</th> @* Usamos Nombre del DTO *@
            <th>@Html.DisplayNameFor(model => model.Email)</th> @* Usamos Email del DTO *@
            <th>Rol</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th> @* Usamos Estado del DTO *@
            <th>Última Conexión</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // El DTO debe contener el nombre del Rol.
            string rowClass = (item.Rol == "Administrador") ? "info" : "";

            <tr class="@rowClass">
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@(item.Rol ?? "Sin Rol")</td>
                <td>
                    @if (item.Estado == true)
                    {
                        <span class="label label-success">Activo</span>
                    }
                    else
                    {
                        <span class="label label-danger">Inactivo</span>
                    }
                </td>
                <td>@item.UltimaConexion.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-xs btn-default" })
                    @* Se podría añadir aquí el botón de Desactivar (Delete) si lo deseas *@
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="mt-3">
    @* Si tu aplicación tiene creación de usuarios por Admin, aquí iría un enlace a /User/Create *@
</p>