@using MvcTienda.Web.Models
@model List<CarritoItemViewModel>

@{
    ViewBag.Title = "Mi Carrito de Compras";
    decimal totalGeneral = Model?.Sum(item => item.Subtotal) ?? 0;
    var culture = new System.Globalization.CultureInfo("es-CR");
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-cart-fill text-info fs-2 me-3"></i>
        <h2 class="fw-bold mb-0">@ViewBag.Title</h2>
    </div>

    @* Manejo de Alertas de Error (TempData o ModelState) *@
    <div id="alert-container">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center py-5">
            <div class="card-body">
                <div class="mb-4">
                    <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-secondary">Tu carrito está vacío</h4>
                <p class="text-muted mb-4">Parece que aún no has añadido nada a tu bolsa de compras.</p>
                <a href="@Url.Action("Index", "Producto")" class="btn btn-info text-white px-4 fw-bold">
                    <i class="bi bi-shop me-2"></i>Ir al Catálogo
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* COLUMNA IZQUIERDA: LISTA DE PRODUCTOS *@
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3">Producto</th>
                                    <th class="py-3">Precio</th>
                                    <th class="py-3 text-center" style="width: 140px;">Cant.</th>
                                    <th class="py-3">Subtotal</th>
                                    <th class="py-3 pe-4 text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr id="row-@item.IdProducto">
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-box-seam text-secondary"></i>
                                                </div>
                                                <div>
                                                    <a href="@Url.Action("Details", "Producto", new { id = item.IdProducto })" class="text-decoration-none fw-bold text-dark">
                                                        @item.NombreProducto
                                                    </a>
                                                    <div class="small text-muted">Stock disponible: <span class="fw-bold text-info">@item.StockDisponible</span></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.PrecioUnitario.ToString("C", culture)</td>
                                        <td class="text-center">
                                            <input type="number"
                                                   class="form-control form-control-sm mx-auto txt-cantidad"
                                                   style="width: 70px;"
                                                   value="@item.Cantidad"
                                                   min="1"
                                                   max="@item.StockDisponible"
                                                   data-id="@item.IdProducto" />
                                        </td>
                                        <td class="fw-bold text-dark subtotal-valor">@item.Subtotal.ToString("C", culture)</td>
                                        <td class="pe-4 text-end">
                                            @* AJUSTE: Formulario con clase para manejo en SweetAlert *@
                                            @using (Html.BeginForm("RemoveItem", "ShoppingCart", FormMethod.Post, new { @class = "form-eliminar" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("idProducto", item.IdProducto)
                                                <button type="button" class="btn btn-link text-danger p-0 btn-eliminar" title="Eliminar">
                                                    <i class="bi bi-trash3 fs-5"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Producto")" class="text-decoration-none text-info fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> Seguir comprando
                    </a>
                </div>
            </div>

            @* COLUMNA DERECHA: RESUMEN *@
            <div class="col-lg-4">
                <div class="card shadow border-0 rounded-4 sticky-top" style="top: 20px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Resumen de Compra</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="resumen-subtotal">@totalGeneral.ToString("C", culture)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Envío</span>
                            <span class="text-success fw-bold">Gratis</span>
                        </div>
                        <hr class="my-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="h5 fw-bold mb-0">Total</span>
                            <span class="h4 fw-bold text-info mb-0 resumen-total">@totalGeneral.ToString("C", culture)</span>
                        </div>
                        @using (Html.BeginForm("Checkout", "ShoppingCart", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <p class="x-small text-muted mb-3 text-center">
                                <i class="bi bi-shield-check me-1"></i> Transacción segura y protegida.
                            </p>
                            <button type="submit" class="btn btn-info text-white btn-lg w-100 py-3 fw-bold shadow-sm">
                                Confirmar Compra <i class="bi bi-chevron-right ms-2 small"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {

            // 1. ELIMINAR PRODUCTO CON SWEETALERT2
            $('.btn-eliminar').on('click', function (e) {
                e.preventDefault();
                const $form = $(this).closest('.form-eliminar');

                Swal.fire({
                    title: '¿Eliminar producto?',
                    text: "Esta acción quitará el artículo de tu carrito de compras.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar',
                    borderRadius: '15px'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $form.submit();
                    }
                });
            });

            // 2. ACTUALIZAR CANTIDAD (CON VALIDACIÓN DE STOCK)
            $('.txt-cantidad').on('change', function () {
                var $input = $(this);
                var idProd = $input.data('id');
                var nuevaCant = parseInt($input.val());
                var maxStock = parseInt($input.attr('max'));
                var $fila = $('#row-' + idProd);

                // Validación local inmediata antes de ir al servidor
                if (nuevaCant < 1 || isNaN(nuevaCant)) {
                    $input.val(1);
                    nuevaCant = 1;
                } else if (nuevaCant > maxStock) {
                    Swal.fire('Stock insuficiente', 'Solo hay ' + maxStock + ' unidades disponibles.', 'info');
                    $input.val(maxStock);
                    nuevaCant = maxStock;
                }

                // Feedback visual de procesamiento
                $fila.css('opacity', '0.5');
                $input.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("UpdateQuantity", "ShoppingCart")',
                    type: 'POST',
                    data: {
                        idProducto: idProd,
                        cantidad: nuevaCant,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        $fila.css('opacity', '1');
                        $input.prop('disabled', false);

                        if (response.success) {
                            $fila.find('.subtotal-valor').text(response.nuevoSubtotal);
                            $('.resumen-subtotal').text(response.nuevoTotal);
                            $('.resumen-total').text(response.nuevoTotal);
                            $('#cart-count').text(response.cartCount).hide().fadeIn();
                            $('#alert-container').empty();
                        } else {
                            mostrarError(response.message);
                            if (response.maxStock !== undefined) {
                                $input.val(response.maxStock);
                            }
                        }
                    },
                    error: function () {
                        $fila.css('opacity', '1');
                        $input.prop('disabled', false);
                        mostrarError("No se pudo conectar con el servidor.");
                    }
                });
            });

            function mostrarError(mensaje) {
                var html = '<div class="alert alert-warning border-0 shadow-sm d-flex align-items-center alert-dismissible fade show" role="alert">' +
                           '<i class="bi bi-exclamation-triangle-fill me-2"></i>' +
                           '<div>' + mensaje + '</div>' +
                           '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                           '</div>';
                $('#alert-container').html(html);
            }
        });
    </script>
}

<style>
    .x-small {
        font-size: 0.75rem;
    }

    .table th {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #6c757d;
    }

    .txt-cantidad {
        border-radius: 8px;
        text-align: center;
        border: 1px solid #dee2e6;
        transition: all 0.2s;
    }

        .txt-cantidad:focus {
            border-color: #0dcaf0;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25);
        }
    /* Estilo para los botones de SweetAlert para que coincidan con el diseño */
    .swal2-popup {
        border-radius: 1.25rem !important;
        font-family: inherit;
    }
</style>