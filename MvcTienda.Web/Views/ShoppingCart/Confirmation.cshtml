@using MvcTienda.Aplicacion.Ordenes
@model OrdenDto

@{
    ViewBag.Title = "¡Gracias por su compra!";
    var currencyCulture = new System.Globalization.CultureInfo("es-CR");
}

<div class="container py-5">
    @* --- ENCABEZADO DE ÉXITO --- *@
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-check-circle-fill text-success fs-1"></i>
        </div>
        <h1 class="fw-bold text-dark">@ViewBag.Title</h1>
        <p class="lead text-muted">Tu orden <span class="fw-bold text-dark">#@Model.Id</span> ha sido procesada con éxito.</p>
    </div>

    <div class="row g-4">
        @* --- RESUMEN DE LA ORDEN --- *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-info"></i>Resumen de Facturación</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small uppercase">Fecha de Compra</div>
                        <div class="col-sm-8 fw-bold">@Model.Fecha.ToString("dd MMMM yyyy, hh:mm tt")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small">Cliente</div>
                        <div class="col-sm-8">@Model.NombreUsuario <span class="text-muted ps-2">(ID: @Model.IdUsuario)</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small">Estado del Pago</div>
                        <div class="col-sm-8"><span class="badge bg-success-subtle text-success border border-success-subtle px-3">Confirmado</span></div>
                    </div>
                    <hr class="my-4 opacity-50">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0">Total Pagado</span>
                        <span class="h3 mb-0 text-info fw-bold">@Model.Total.ToString("C", currencyCulture)</span>
                    </div>
                </div>
            </div>

            @* --- TABLA DE PRODUCTOS --- *@
            <div class="card shadow-sm border-0 rounded-4 mt-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-info"></i>Productos Comprados</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end pe-4">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.NombreProducto</div>
                                        <div class="text-muted small">Precio unit: @item.PrecioUnitario.ToString("C", currencyCulture)</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-light text-dark border">@item.Cantidad</span>
                                    </td>
                                    <td class="text-end pe-4 fw-bold text-dark">@item.Subtotal.ToString("C", currencyCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* --- COLUMNA ACCIONES --- *@
        <div class="col-lg-5">
            <div class="card shadow border-0 rounded-4 bg-dark text-white p-4 h-100">
                <h4 class="fw-bold mb-4">¿Qué sigue?</h4>
                <div class="d-flex mb-4">
                    <div class="me-3 fs-3 text-info"><i class="bi bi-envelope"></i></div>
                    <div>
                        <h6 class="mb-1 fw-bold">Correo de Confirmación</h6>
                        <p class="small text-white-50">Hemos enviado el detalle de tu factura a tu correo electrónico registrado.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3 fs-3 text-info"><i class="bi bi-truck"></i></div>
                    <div>
                        <h6 class="mb-1 fw-bold">Preparando tu Envío</h6>
                        <p class="small text-white-50">Nuestros asociados están preparando tus productos. Te avisaremos cuando salgan de bodega.</p>
                    </div>
                </div>

                <div class="mt-auto pt-4 border-top border-secondary">
                    <div class="d-grid gap-3">
                        @* Link ajustado a la sección de órdenes en Perfil *@
                        <a href="@Url.Action("Index", "Perfil")" class="btn btn-outline-info btn-lg fs-6 py-3">
                            <i class="bi bi-clock-history me-2"></i>Ver Mis Órdenes
                        </a>
                        <a href="@Url.Action("Index", "Producto")" class="btn btn-info text-white btn-lg fs-6 py-3 fw-bold">
                            <i class="bi bi-shop me-2"></i>Seguir Comprando
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .uppercase {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }
</style>