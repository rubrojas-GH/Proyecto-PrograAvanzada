<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Tienda Bazar</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @* Carga de iconos global *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar {
            border-bottom: 3px solid #0dcaf0;
        }

        .dropdown-menu {
            border: none;
            border-radius: 10px;
        }

        .navbar .nav-link:not(.btn):hover {
            color: #0dcaf0 !important;
        }

        .navbar .btn-outline-info:hover {
            background-color: #0dcaf0;
            color: #000 !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                <i class="bi bi-shop-window text-info me-2"></i>Tienda Bazar
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Producto")">Tienda</a>
                    </li>

                    @if (Request.IsAuthenticated && User.IsInRole("Administrador"))
                    {
                        <li class="nav-item dropdown">
                            @* IMPORTANTE: data-bs-toggle es para Bootstrap 5 *@
                            <a class="nav-link dropdown-toggle text-info fw-bold" href="#" id="dropMante"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-fill me-1"></i>Mantenimiento
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg mt-2" aria-labelledby="dropMante">
                                <li><h6 class="dropdown-header opacity-50">GESTIÓN DE INVENTARIO</h6></li>
                                <li><a class="dropdown-item" href="@Url.Action("AdminIndex", "Producto")"><i class="bi bi-box-seam me-2"></i>Productos</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Categoria")"><i class="bi bi-grid me-2"></i>Categorías</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header opacity-50">SISTEMA</h6></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "User")"><i class="bi bi-people me-2"></i>Usuarios</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Moderation", "Resena")"><i class="bi bi-chat-left-text me-2"></i>Reseñas</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-info"
                               href="@Url.Action("Index", "Dashboard")">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>

                    }
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()
        <footer class="mt-5 py-4 text-center text-muted border-top">
            <p>&copy; @DateTime.Now.Year - <span class="fw-bold text-dark">Tienda Bazar</span></p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/confirm-delete.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>