@model IEnumerable<MvcTienda.Aplicacion.Categorias.CategoriaDto>

@{
    ViewBag.Title = "Bazar y Librería - Tu Rincón de Cultura";
    var destacados = ViewBag.ProductosDestacados as IEnumerable<MvcTienda.Aplicacion.Productos.ProductoDto>;
}

<main>
    @* --- SECCIÓN: BARRA DE HERRAMIENTAS TÉCNICAS (Solo Administradores) --- *@
    @if (User.IsInRole("Administrador"))
    {
        <div class="card border-0 shadow-sm mb-5 bg-light">
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <h5 class="mb-0 fw-bold text-secondary">
                            <i class="bi bi-tools me-2 text-info"></i>Accesos de Mantenimiento
                        </h5>
                        <p class="small mb-0 text-muted">Gestión directa de inventario y moderación de contenido.</p>
                    </div>
                    <div class="col-md-7 text-md-end mt-3 mt-md-0">
                        <div class="btn-group shadow-sm">
                            <a href="@Url.Action("AdminIndex", "Producto")" class="btn btn-outline-dark border-secondary-subtle">
                                <i class="bi bi-box-seam me-1"></i> Productos
                            </a>
                            <a href="@Url.Action("Index", "Categoria")" class="btn btn-outline-dark border-secondary-subtle">
                                <i class="bi bi-grid me-1"></i> Categorías
                            </a>
                            <a href="@Url.Action("Index", "User")" class="btn btn-outline-dark border-secondary-subtle">
                                <i class="bi bi-people me-1"></i> Usuarios
                            </a>
                            <a href="@Url.Action("Moderation", "Resena")" class="btn btn-outline-dark border-secondary-subtle">
                                <i class="bi bi-chat-right-dots me-1"></i> Reseñas
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- SECCIÓN HERO --- *@
    <div class="jumbotron-bg p-5 mb-5 rounded-4 shadow-lg position-relative overflow-hidden"
         style="background-image: url('https://i.pinimg.com/736x/6d/0c/d2/6d0cd23779c2016e9950be4d25722ec9.jpg'); background-size: cover; background-position: center; min-height: 400px;">

        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.2));"></div>

        <div class="position-relative container py-5 text-center text-white">
            <h1 class="display-3 fw-bold mb-3 mt-4">Descubre Historias y Detalles Únicos</h1>
            <p class="lead fs-3 mb-5 opacity-90">Desde clásicos de la literatura hasta artículos para tu hogar y oficina.</p>
            <a href="@Url.Action("Index", "Producto")" class="btn btn-warning btn-lg px-5 py-3 shadow-lg fw-bold rounded-pill border-0 transition-hover">
                Explorar la Colección <i class="bi bi-book-half ms-2"></i>
            </a>
        </div>
    </div>

    @* --- SECCIÓN DE PRODUCTOS DESTACADOS --- *@
    <h2 class="mt-5 mb-4 text-center text-primary border-bottom pb-2">🔥 Ofertas de la Semana</h2>

    <div class="row g-4 mb-5">
        @if (destacados != null && destacados.Any())
        {
            foreach (var prod in destacados)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <img src="@(prod.Imagenes != null && prod.Imagenes.Any() ? prod.Imagenes.First().UrlImagen : "https://placehold.co/600x400?text=Producto")"
                             class="card-img-top" alt="@prod.Nombre" style="height: 200px; object-fit: cover;">

                        <div class="card-body text-center">
                            <h5 class="card-title text-truncate">@prod.Nombre</h5>
                            <p class="card-text text-success fw-bold fs-5">@prod.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</p>
                            <a href="@Url.Action("Details", "Producto", new { id = prod.Id })" class="btn btn-outline-primary w-100 rounded-pill">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted small italic">No hay productos destacados actualmente.</p>
            </div>
        }
    </div>

    @* --- SECCIÓN DE CATEGORÍAS --- *@
    <h2 class="mt-5 mb-4 text-center text-secondary border-bottom pb-2">Explorar por Categoría</h2>

    <div class="row g-4 text-center mb-5">
        @if (Model != null && Model.Any())
        {
            foreach (var cat in Model.Take(3))
            {
                <div class="col-md-4">
                    <div class="bg-white p-4 rounded-3 shadow-sm border transition-hover h-100">
                        <i class="bi bi-bookmark-star text-info display-4 mb-3 d-block"></i>
                        <h3 class="fs-4 mt-2">@cat.NombreCategoria</h3>
                        <a href="@Url.Action("Index", "Producto", new { categoriaId = cat.IdCategoria })" class="btn btn-link text-info text-decoration-none fw-bold">Ver todo en @cat.NombreCategoria &rarr;</a>
                    </div>
                </div>
            }
        }
    </div>
</main>